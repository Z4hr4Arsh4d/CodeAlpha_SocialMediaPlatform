# Copy to .env and change the secret before deploying anywhere public.
#   Windows: copy .env.example .env

PORT=4000

# Signs the session cookie. Any long random string.
SESSION_SECRET=change-this-to-a-long-random-string

# Where the SQLite file lives. Created automatically.
DB_PATH=./data/social.db

# Set to "production" to require HTTPS for the session cookie.
NODE_ENV=development
